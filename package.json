{
  "name": "stegstr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:web": "tsc && vite build --base /app/",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:mac": "tauri build",
    "build:win": "tauri build",
    "build:linux": "tauri build",
    "launch:profile1": "./scripts/launch-profile-1.sh",
    "launch:profile2": "./scripts/launch-profile-2.sh",
    "launch:both": "./scripts/launch-both-profiles.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/run-permutations.mjs",
    "build:mcp": "esbuild src/mcp-server.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist-mcp/server.mjs --external:@napi-rs/canvas",
    "mcp": "npm run build:mcp && node dist-mcp/server.mjs",
    "bench": "esbuild benchmarks/run.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist-mcp/bench.mjs --external:@napi-rs/canvas && node dist-mcp/bench.mjs",
    "build:pages": "tsc && vite build --base /Stegstr/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@noble/ciphers": "^2.3.0",
    "@noble/hashes": "^2.0.1",
    "@noble/secp256k1": "^3.0.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "bech32": "^2.0.0",
    "pako": "^2.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.5",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^28.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.0.18"
  }
}
